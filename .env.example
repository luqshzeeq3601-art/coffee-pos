# ==============================================================================
# Coffee POS & ERP Environment Configuration
# Disposable local development values only. Never commit real secrets.
# ==============================================================================

# Database & Cache (Infra)
POSTGRES_DB=coffee_pos_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend API (.NET 9)
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000;https://localhost:5001
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=coffee_pos_dev;Username=postgres;Password=postgres
ConnectionStrings__Redis=localhost:6379

# Frontend Services (Vite / React)
VITE_API_URL=http://localhost:5000/api
VITE_ENABLE_MOCK_HARDWARE=true
VITE_MYINVOIS_SANDBOX_ENABLED=true

# MyInvois (LHDN Malaysia E-Invoicing Sandbox)
MYINVOIS_CLIENT_ID=mock_client_id
MYINVOIS_CLIENT_SECRET=mock_client_secret
MYINVOIS_ENVIRONMENT=sandbox
